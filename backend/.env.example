# =============================================================================
# AlgoVision backend — environment variables (template)
# =============================================================================
# Copy to .env (gitignored) and fill in real values. Never commit secrets.
#
#   cp .env.example .env
#
# B1.1 only wires the DATABASE_URL slot. Subsequent phase-1 commits add
# settings for logging, CORS, auth secrets, etc. Each new setting lands in
# its own commit so the diff stays reviewable.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# One of: development | test | production. Drives log format, CORS, etc.
APP_ENV=development

# -----------------------------------------------------------------------------
# Database (Supabase managed PostgreSQL 16)
# -----------------------------------------------------------------------------
# 1) Go to Supabase project -> Settings -> Database -> Connection string.
# 2) Pick the "Transaction pooler" (port 6543) for serverless/edge,
#    "Direct connection" (port 5432) for migrations + long-lived sessions.
# 3) Replace [YOUR-PASSWORD] with the database password you set when
#    creating the project. URL-encode special characters if needed.
#
# Direct connection (recommended for Alembic migrations + app session):
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Sync driver URL is required by Alembic (uses psycopg2). Same host/port,
# different driver prefix.
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Pool sizing (optional, defaults are conservative).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Supabase (client-side features, optional in B1.1)
# -----------------------------------------------------------------------------
# We own auth (Argon2id + cookies), so these are only needed if/when we add
# Supabase Storage or Realtime features. Safe to leave blank initially.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Auth (filled in by B1.2 settings module)
# -----------------------------------------------------------------------------
# SECRET_KEY must be a long random string (>=32 bytes). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
# Argon2id cost parameters (defaults are sane; tune only if needed).
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Access / refresh token lifetimes (seconds).
ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 days

# Cookie attributes
COOKIE_SECURE=false                   # true in production (HTTPS only)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=                         # leave blank in development

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. NEVER use "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# In non-development, logs are emitted as JSON to stdout.
# In development, pretty-printed for human reading.

# -----------------------------------------------------------------------------
# Rate limiting (slowapi)
# -----------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# -----------------------------------------------------------------------------
# Observability (filled in later phases)
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=false