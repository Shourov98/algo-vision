# =============================================================================
# AlgoVision .gitignore
# Python (backend) + Node/Next.js (frontend) + general
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & secrets — NEVER commit
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.pem
*.key
secrets/
credentials/
service-account*.json
gcloud-service-account.json
*.p12

# -----------------------------------------------------------------------------
# Python (backend) — FastAPI / SQLAlchemy / Alembic / pytest
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
dist/
build/
*.whl
*.tar.gz

.venv/
venv/
env/
ENV/
.venv-*/

.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.mypy_cache/
.ruff_cache/

# Database
*.db
*.sqlite
*.sqlite3

# -----------------------------------------------------------------------------
# Node / Next.js / pnpm
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*

.next/
out/
build/
dist/

# Test artifacts
coverage/
.nyc_output/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Cache
.eslintcache
.cache/

# -----------------------------------------------------------------------------
# IDE / editor
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
*~

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# -----------------------------------------------------------------------------
# Docker / local dev
# -----------------------------------------------------------------------------
docker-compose.override.yml
*.pid
*.seed
*.pid.lock

# -----------------------------------------------------------------------------
# Generated by tools (e.g., lefthook, release-please)
# -----------------------------------------------------------------------------
lefthook.yml.local
release-please-config.json.local